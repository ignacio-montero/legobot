# Copy to .env and fill in. NEVER commit the real .env.

# From @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your personal chat id. Message the bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id
TELEGRAM_CHAT_ID=000000000

# --- optional, these are the defaults ---
# POLL_INTERVAL_MINUTES=5    # slow tier: full catalogue sweep
# FAST_INTERVAL_SECONDS=30   # fast tier: in-stock-only; drives availability alerts
# FAST_TIER_ENABLED=1        # set 0 to fall back to slow-tier-only
# ACTIVE_START=07:00
# ACTIVE_END=19:00
# TZ=Europe/London
# MAX_TRACKED_SETS=100
# LEGOBOT_DB_PATH=/data/legobot.sqlite3
# LOG_LEVEL=INFO
